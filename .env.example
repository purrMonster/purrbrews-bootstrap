# Copy to .env to change the defaults. Everything here is optional.

# Which release to run, and where the image comes from.
#BOOTSTRAP_VERSION=1.0.0
#BOOTSTRAP_IMAGE=ghcr.io/purrmonster/purrbrews-bootstrap

# Publish the client port on one address only (e.g. this machine's LAN address).
#BOOTSTRAP_BIND=0.0.0.0
#BOOTSTRAP_PORT=8443
#BOOTSTRAP_ADMIN_PORT=8444

# What clients are told to use, if you would rather not set it on the admin page.
#BOOTSTRAP_PUBLIC_URL=https://192.0.2.10:8443

# Linux: run the container as the owner of ./data (id -u, id -g).
#BOOTSTRAP_UID=1000
#BOOTSTRAP_GID=1000

# Use your own admin token instead of the generated one (16+ characters).
#BOOTSTRAP_ADMIN_TOKEN=

# Serve a folder from elsewhere as the payload (default: ./data/payload).
#BOOTSTRAP_PAYLOAD=../my-project/setup
